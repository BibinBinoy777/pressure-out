# =============================================================================
# PRESSURE OUT — LOCAL WINDOWS DEVELOPMENT TEMPLATE (.env.local.example)
# =============================================================================
# Copy to `.env.local` (and `backend/.env` if running backend directly):
#   Copy-Item .env.local.example .env.local
#
# CRITICAL D: DRIVE STORAGE CONFIGURATION:
# All caches, virtual environments, media storage, and backups are directed to
# D:\PressureOut so the C: drive is never exhausted.
#
# ENVIRONMENT MODES:
# - Development (`APP_ENV=development`): Local Windows dev against local PG 16 & Redis 7.
# - Test (`APP_ENV=test`): Automated unit/integration test execution.
# - Production (`APP_ENV=production`): Strict fail-fast production mode (requires HTTPS,
#   custom 32-byte secrets, PostgreSQL, Redis, and non-mock providers).
# =============================================================================

# --- D: Drive Project & Cache Locations ---
LOCAL_PROJECT_ROOT=D:/PressureOut
LOCAL_DATA_ROOT=D:/PressureOut/.local-data
LOCAL_BACKUP_DIR=D:/PressureOut/.local-data/backups
PIP_CACHE_DIR=D:/PressureOut/.cache/python
NPM_CONFIG_CACHE=D:/PressureOut/.cache/npm
PLAYWRIGHT_BROWSERS_PATH=D:/PressureOut/.cache/playwright
TEMP=D:/PressureOut/.cache/tmp
TMP=D:/PressureOut/.cache/tmp

# --- Application Mode ---
APP_ENV=development
APP_NAME="Pressure Out API"
APP_VERSION=0.8.1
LOG_LEVEL=INFO
WEB_CONCURRENCY=1

# --- Local PostgreSQL 16 (docker-compose.local.yml on 127.0.0.1:54329) ---
LOCAL_POSTGRES_USER=po_local_user
LOCAL_POSTGRES_PASSWORD=po_local_win_pg_pass_change_me
LOCAL_POSTGRES_DB=pressure_out_local
LOCAL_POSTGRES_PORT=54329

DATABASE_URL=postgresql+asyncpg://po_local_user:po_local_win_pg_pass_change_me@127.0.0.1:54329/pressure_out_local
TEST_DATABASE_URL=postgresql+asyncpg://po_local_user:po_local_win_pg_pass_change_me@127.0.0.1:54329/pressure_out_local_test

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# --- Local Redis 7 Rate Limiting (docker-compose.local.yml on 127.0.0.1:63799) ---
LOCAL_REDIS_PORT=63799
LOCAL_REDIS_PASSWORD=po_local_win_redis_pass_change_me
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://:po_local_win_redis_pass_change_me@127.0.0.1:63799/0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
RATE_LIMIT_FAIL_CLOSED=true

# --- Session & Cryptographic Placeholders (Replace in Production) ---
SESSION_COOKIE_NAME=po_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
EMAIL_HMAC_PEPPER=po_local_win_only_hmac_pepper_at_least_24_chars
# Default dev AES-256-GCM key is derived automatically if omitted in development

# --- CORS & Frontend/Backend URLs ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Local Media Storage on D: Drive ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=D:/PressureOut/.local-data/media
MAX_JSON_REQUEST_BYTES=1048576
MAX_MULTIPART_UPLOAD_BYTES=6291456

# --- AI Meme Studio & Translation Providers (Offline Safe Defaults) ---
# Set to `local_mock` for deterministic local testing or `disabled` to test kill-switches
AI_CAPTION_PROVIDER=local_mock
AI_IMAGE_PROVIDER=local_mock
TRANSLATION_PROVIDER=local_mock
MEME_MAX_PROMPT_CHARS=400
MEME_CAPTION_DAILY_LIMIT=15
MEME_IMAGE_DAILY_LIMIT=5
MEME_MAX_CONCURRENT_JOBS=1
MEME_JOB_MAX_RETRIES=1
AI_DAILY_SPEND_CAP_USD=25.0

# --- Privacy-Safe Workplace Insights Thresholds ---
INSIGHTS_MIN_COHORT_SIZE=10
INSIGHTS_SENSITIVE_MIN_COHORT_SIZE=20
INSIGHTS_MIN_CATEGORY_BUCKET_COUNT=3
