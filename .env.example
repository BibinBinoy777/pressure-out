# =============================================================================
# PRESSURE OUT — LOCAL DEVELOPMENT CONFIGURATION (.env.example)
# =============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY WARNING:
# - Use ONLY safe local-development placeholders in this file.
# - NEVER commit `.env` or real passwords, session keys, or AI provider keys.
# =============================================================================

# --- Application Environment ---
APP_ENV=development
APP_NAME="Pressure Out API"
APP_VERSION=0.2.0
LOG_LEVEL=INFO

# --- FastAPI Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL 16 Database (Local Development Only) ---
POSTGRES_USER=po_dev_user
POSTGRES_PASSWORD=po_dev_local_only_password_change_me
POSTGRES_DB=pressure_out_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy 2.x Async Connection URL (used by Backend & Alembic)
# Note: Inside Docker Compose, POSTGRES_HOST is overridden to `db`.
DATABASE_URL=postgresql+asyncpg://po_dev_user:po_dev_local_only_password_change_me@localhost:5432/pressure_out_dev

# Isolated Test Database URL (used for destructive migration & DB integration tests)
TEST_DATABASE_URL=postgresql+asyncpg://po_dev_user:po_dev_local_only_password_change_me@localhost:5432/pressure_out_test

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# --- Frontend <-> Backend Communication ---
# Browser-accessible backend base URL (used by client-side browser requests)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-internal backend base URL (used by Next.js SSR inside Docker network)
INTERNAL_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Local Development Media Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=../storage/media

# --- External AI & Translation Providers (Disabled by Default in Phase 2) ---
# Phase 2 operates 100% offline without commercial AI or translation keys.
AI_CAPTION_PROVIDER=disabled
AI_IMAGE_PROVIDER=disabled
TRANSLATION_PROVIDER=disabled

# Phase 8 AI Meme Studio Quotas & Safety Limits
MEME_MAX_PROMPT_CHARS=400
MEME_CAPTION_DAILY_LIMIT=15
MEME_IMAGE_DAILY_LIMIT=5
MEME_MAX_CONCURRENT_JOBS=1
MEME_JOB_MAX_RETRIES=1
MEME_PROVIDER_TIMEOUT_SEC=15.0
AI_DAILY_SPEND_CAP_USD=25.0
